# Copy this file to .env and fill in your key, then restart `npm run dev`.

# Optional, local development only: a TTS.ai API key, so you needn't enter it in the page.
# Never set this for a public build: Vite compiles it into the JavaScript anyone can read.
# Without a key, TTS.ai only allows limited anonymous use of free models.
VITE_TTS_API_KEY=

# Optional: where API requests are sent.
# Default "/tts-api" goes through the Vite dev/preview proxy. A hosted build sets
# https://api.tts.ai, which accepts browser requests from any site.
# VITE_TTS_API_ORIGIN=/tts-api
