# Copy this file to .env and fill in your key, then restart `npm run dev`.

# TTS.ai API key (create one in your TTS.ai account under API).
# Without a key, TTS.ai only allows limited anonymous use of free models.
VITE_TTS_API_KEY=

# Optional: where API requests are sent.
# Default "/tts-api" goes through the Vite dev/preview proxy (avoids CORS).
# Set to https://api.tts.ai to call TTS.ai directly, or to your own reverse proxy in production.
# VITE_TTS_API_ORIGIN=/tts-api
